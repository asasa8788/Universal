{
	"apps": [
		{
			"id": "DualSubs.Translate.deeplx",
			"name": "🍿️ DualSubs: DeepLX 专用配置（asasa8788 二开版）",
			"author": "asasa8788",
			"repo": "https://github.com/asasa8788/Universal",
			"icon": "https://github.com/asasa8788/YouTube/raw/main/src/assets/icon_rounded.png",
			"openUrl": "https://github.com/asasa8788/Universal/releases/tag/v1.7.5%2Bdeeplx.1",
			"desc": "本面板为二开版补充：官方面板的 Vendor 字段写入 @DualSubs.Universal 作用域，对 YouTube 视频不生效；本面板把 Vendor 与 DeepLX 配置写入实际读取链（YouTube → Translate → API）。配置后请重启播放器。"
		,	"keys": [
				"@DualSubs.Translate.Settings.Vendor",
				"@DualSubs.API.Settings.DeepLX.Endpoint",
				"@DualSubs.API.Settings.DeepLX.Auth"
			],
			"settings": [
				{
					"id": "@DualSubs.Translate.Settings.Vendor",
					"name": "[翻译器] 服务商（YouTube 视频实际读取此处）",
					"type": "selects",
					"val": "DeepLX",
					"items": [
						{ "key": "Google", "label": "Google Translate" },
						{ "key": "Microsoft", "label": "Microsoft Translator（需填写API）" },
						{ "key": "DeepL", "label": "DeepL 官方 API（需填写Auth）" },
						{ "key": "DeepLX", "label": "DeepLX（自建，推荐）" }
					],
					"desc": "必须设为 DeepLX 才会启用自建翻译服务"
				},
				{
					"id": "@DualSubs.Translate.Settings.ShowOnly",
					"name": "[翻译器] 只显示翻译字幕",
					"type": "boolean",
					"val": false,
					"desc": "开启后仅显示译文行"
				},
				{
					"id": "@DualSubs.API.Settings.DeepLX.Endpoint",
					"name": "[DeepLX] API 终结点（完整地址）",
					"type": "text",
					"val": "",
					"desc": "必须包含 /translate 路径，例：https://your.host:1188/translate"
				},
				{
					"id": "@DualSubs.API.Settings.DeepLX.Auth",
					"name": "[DeepLX] API Token（免鉴权可留空）",
					"type": "text",
					"val": "",
					"desc": "以 Authorization: Bearer <值> 发送"
				}
			]
		}
	]
}
